# Backend Environment Variables
# Copy this file to 'env' and update the values with your actual API keys

# AI API Keys
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Processing Configuration
DO_OCR=false
SAFE_MODE=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (optional - defaults to SQLite)
# DATABASE_URL=sqlite:///./data/data/app.db