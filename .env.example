# ============================================================
# .env.example — INETUM Multi-Agent Financial Analysis
# ============================================================
# Copy this file to .env and fill in your own API keys.
# NEVER commit the .env file to version control.
# ============================================================

# ─── AI API KEYS (REQUIRED) ──────────────────────────────────

# Google Gemini API Key — Used by ALL agents (CrewAI + Agno)
# Required for: scraping agent, KPI extractor, report generator
# Get it at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI API Key — Optional fallback for CrewAI embedding tools
# Required only if using OpenAI-based tools (not mandatory)
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── EXTRACTION CONFIGURATION ────────────────────────────────

# Enable OCR for scanned PDFs (true/false) — default: false
DO_OCR=false

# Safe mode: disables table extraction to avoid memory issues (true/false)
SAFE_MODE=false

# ─── BACKEND API CONFIGURATION ───────────────────────────────

# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8000

# ─── DATABASE (OPTIONAL) ─────────────────────────────────────

# SQLite (default, no configuration needed)
# DATABASE_URL=sqlite:///./data/data/app.db

# PostgreSQL (optional, for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
